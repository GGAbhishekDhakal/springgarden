# Database (PostgreSQL). For Vercel, use Neon/Supabase/Vercel Postgres and paste the connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Admin auth - set a long random secret in production
AUTH_SECRET="replace-with-a-long-random-secret"
# Optional: bootstrap first admin (used only by a setup script if you add one)
# ADMIN_EMAIL="admin@springgarden.edu.np"
# ADMIN_PASSWORD="change-me"

# Cloudinary (image uploads for gallery/staff). Create a free account at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Optional folder prefix
CLOUDINARY_FOLDER="springgarden"

# Public site URL (used for metadata)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
